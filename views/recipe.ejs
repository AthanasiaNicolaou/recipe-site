<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <title><%= recipe.title %></title>
    </head>
    <body>
        <a href="/">&larr; Back to all recipes</a> <!--&larr; is an HTML entity — a special code you type in HTML source that the browser converts into a specific character/symbol when it displays the page. In this case, it renders as a left-pointing arrow: ← -->
        <h1><%= recipe.title %></h1>
        <form action="/recipes/<%= recipe.id %>/delete" method="POST">
            <button type="submit">Delete this recipe</button>
        </form>
        <p>Time needed: <%= recipe.time_needed %></p>

        <h2>Ingredients</h2>
        <u1> <!--<ul> / <li> — an unordered (bulleted) list; each ingredient becomes one bullet point.-->
            <% recipe.ingredients.split('\n').forEach(function(line) { %> 
            <li><%= line %></li>
        <% }); %>
        </u1>

        <h2>Instructions</h2>
        <ol> <!--<ol> / <li> — an ordered (numbered) list; used for instructions since step order matters.-->
            <% recipe.instructions.split('\n').forEach(function(line) { %>
            <li><%= line %></li>
        <% }); %>
        </ol>
    </body>
    </body>
</html>

<!--OTHER ENTITIES
&gt; → >
&lt; → <
&amp; → &
&nbsp; → a non-breaking space (a space that won't let text wrap/break at that point)
&copy; → ©
-->