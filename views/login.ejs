<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <title>Log In</title>
    </head>
    <body>
        <h1>Log In</h1>

        <form action="/login" method="POST">
            <label>Email:<br />
                <input type="email" name="email" required />
            </label><br /><br />

            <label>Password:<br />
                <input type="password" name="password" required />
            </label><br /><br />

            <button type="submit">Log in</button>
        </form>
    </body>
</html>