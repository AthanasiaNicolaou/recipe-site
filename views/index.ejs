<!DOCTYPE html>
<html lang="en"> 
    <head>
        <meta charset="UTF-8" />
        <title> My Recipe Site</title>
    </head>
    <body>
        <h1>My Recipes</h1>
        <a href="/recipes/new">+ Add a new recipe <!--href: (anchor/link) tag that says where the link goes | <a>...</a> — creates a clickable link. Whatever text/content is between the opening and closing tags is what the user sees and clicks (here, "+ Add a new recipe").--> </a>
        <% recipes.forEach(function(recipe) { %><!--a JavaScript array method that runs the function once for each item in the array. Each time through, recipe refers to one recipe object (one row from the database).-->
            <div> <!--purpose: to be a generic container/box that groups other content together.-->
                <h2><a href="/recipes/<%= recipe.id %>"><%= recipe.title %></a></h2> <!--Everything outside the <% %> tags is literal text, unchanged. Everything inside gets replaced with the actual value. So if this specific recipe's id is 3, EJS builds the final HTML as:href="/recipes/3"-->
                <% if(recipe.time_needed) { %>
                <p>Time needed: <%= recipe.time_needed %></p>
                <% } %>
            </div>
        <%}); %>   
    </body>
</html>

<!-- 
<% %> (no equals sign) — runs plain JavaScript logic, outputs nothing itself. Used here for the forEach loop structure.
<%= %> (with equals sign) — runs JavaScript and inserts the result into the page as text. Used here to actually print recipe.title and recipe.time_needed.
-->